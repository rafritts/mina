#!/usr/bin/env bash
# mina — management CLI for Mina (chat UI + neurosim)
# Installed at ~/.local/bin/mina → scripts/mina

set -euo pipefail

REPO_DIR="$(cat ~/.config/mina/dir 2>/dev/null || echo "")"
if [[ -z "$REPO_DIR" ]]; then
    echo "Error: mina not installed. Run scripts/install.sh first." >&2
    exit 1
fi

SERVICE="mina"
RUN_DIR="$REPO_DIR/run"
UI_PORT="${MINA_UI_PORT:-2050}"
BACKEND_PORT="${MINA_BACKEND_PORT:-5100}"

_svc() { systemctl --user "$@" "$SERVICE"; }

_build_ui() {
    echo "Building UI..."
    (cd "$REPO_DIR/ui" && npm install --silent && npm run build)
}

# Print the live UI build id in a form agents must surface to the user.
_print_build_id() {
    local raw id
    raw="$(curl -sf "http://localhost:${UI_PORT}/api/build" 2>/dev/null || true)"
    if [[ -z "$raw" ]]; then
        echo "Build id: (unavailable — UI not answering /api/build)" >&2
        return 1
    fi
    id="$(printf '%s' "$raw" | python3 -c "import sys,json; print(json.load(sys.stdin).get('id',''))" 2>/dev/null || true)"
    if [[ -z "$id" ]]; then
        # Fallback: whole body if not JSON
        id="$raw"
    fi
    echo "GIVE THIS BUILD ID TO THE USER ${id}"
    echo "Build: ${raw}"
}

cmd="${1:-help}"
shift || true

case "$cmd" in

install)
    bash "$REPO_DIR/scripts/install.sh"
    ;;

uninstall)
    read -rp "Uninstall mina? This removes the service and CLI symlink. [y/N] " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || exit 0
    _svc stop 2>/dev/null || true
    _svc disable 2>/dev/null || true
    rm -f ~/.config/systemd/user/mina.service
    systemctl --user daemon-reload
    rm -f ~/.local/bin/mina
    rm -rf ~/.config/mina
    echo "Uninstalled."
    ;;

setup)
    # Regenerate the systemd unit file (e.g. after repo moves)
    bash "$REPO_DIR/scripts/install.sh" --setup-only
    ;;

start)
    _svc start
    echo -n "Starting"
    for _ in $(seq 1 90); do
        sleep 1
        echo -n "."
        if [[ -f "$RUN_DIR/ready" ]] || curl -sf "http://localhost:${UI_PORT}/" &>/dev/null; then
            echo " ready."
            echo "UI: http://localhost:${UI_PORT}"
            exit 0
        fi
    done
    echo " timed out waiting for ready signal."
    exit 1
    ;;

stop)
    _svc stop
    ;;

restart)
    # Rebuild then restart — same idea as kairu restart after deploy.
    _build_ui
    echo "Restarting..."
    _svc restart
    echo -n "Waiting"
    for _ in $(seq 1 90); do
        sleep 1
        echo -n "."
        if [[ -f "$RUN_DIR/ready" ]] || curl -sf "http://localhost:${UI_PORT}/" &>/dev/null; then
            echo " ready."
            _print_build_id || true
            exit 0
        fi
    done
    echo " timed out."
    exit 1
    ;;

status)
    _svc status
    echo ""
    echo "UI:      http://localhost:${UI_PORT}"
    echo "Backend: http://localhost:${BACKEND_PORT}/health"
    _print_build_id || true
    ;;

enable)
    _svc enable
    echo "Autostart enabled."
    ;;

disable)
    _svc disable
    echo "Autostart disabled."
    ;;

logs)
    n=100
    follow=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f) follow=true; shift ;;
            -n) n="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    if $follow; then
        journalctl --user -u "$SERVICE" -n "$n" -f
    else
        journalctl --user -u "$SERVICE" -n "$n" --no-pager
    fi
    ;;

rebuild)
    _build_ui
    echo "Restarting..."
    _svc restart
    echo -n "Waiting"
    for _ in $(seq 1 90); do
        sleep 1
        echo -n "."
        if [[ -f "$RUN_DIR/ready" ]] || curl -sf "http://localhost:${UI_PORT}/" &>/dev/null; then
            echo " ready."
            _print_build_id || true
            exit 0
        fi
    done
    echo " timed out."
    exit 1
    ;;

update)
    echo "Pulling latest..."
    git -C "$REPO_DIR" pull
    echo "Syncing Python dependencies..."
    (cd "$REPO_DIR" && uv sync)
    _build_ui
    echo "Restarting..."
    _svc restart
    echo -n "Waiting"
    for _ in $(seq 1 90); do
        sleep 1
        echo -n "."
        if [[ -f "$RUN_DIR/ready" ]] || curl -sf "http://localhost:${UI_PORT}/" &>/dev/null; then
            echo " ready."
            _print_build_id || true
            exit 0
        fi
    done
    echo " timed out."
    exit 1
    ;;

reset)
    # Chemistry-only baseline reset (live process via API).
    if ! curl -sf "http://localhost:${BACKEND_PORT}/health" &>/dev/null; then
        echo "Backend not up on :${BACKEND_PORT}. Is mina running?" >&2
        exit 1
    fi
    if [[ "${1:-}" != "--yes" ]]; then
        read -rp "Reset chemistry to baseline (keeps chat/memory)? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || exit 0
    fi
    curl -sf -X POST "http://localhost:${BACKEND_PORT}/api/state/reset" | python3 -m json.tool
    echo "Reset complete."
    ;;

factory-reset)
    confirm=false
    [[ "${1:-}" == "--yes" ]] && confirm=true
    if ! $confirm; then
        read -rp "Factory reset: clear all runtime state, events, history, and memory? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || exit 0
    fi
    rm -f "$RUN_DIR/sim_state.json"
    rm -f "$RUN_DIR/conversation-"*.jsonl
    rm -f "$RUN_DIR/events.jsonl"
    rm -f "$RUN_DIR/history.jsonl"
    rm -f "$RUN_DIR/obs.jsonl"
    rm -f "$RUN_DIR/token_stats.json"
    rm -f "$RUN_DIR/consolidation_state.json"
    rm -f "$RUN_DIR/decoder_window.json"
    rm -f "$RUN_DIR/sliding_seq.json"
    rm -f "$RUN_DIR/prior_emotional_state.json"
    rm -f "$RUN_DIR/last_freetime.json"
    rm -f "$RUN_DIR/last_freetime.md"
    rm -f "$RUN_DIR/freetime_log.jsonl"
    rm -f "$RUN_DIR/turns.jsonl"
    rm -rf "$RUN_DIR/chat-images"
    rm -rf "$REPO_DIR/memory/rag"
    find "$REPO_DIR/memory/kag" -type f -delete
    find "$REPO_DIR/memory/relationships" -type f -delete
    echo "Factory reset complete. Restarting service..."
    _svc restart
    ;;

help|--help|-h)
    cat <<EOF
mina — Mina chat + neurosim management

Setup:
  install          Full setup: deps, build UI, service, autostart, start
  uninstall        Remove service and CLI symlink
  setup            Regenerate systemd unit file only

Service:
  start            Start the service (backend :${BACKEND_PORT}, UI :${UI_PORT})
  stop             Stop the service
  restart          Rebuild UI + restart (fresh build id)
  status           Service status + build id
  enable           Enable autostart on boot
  disable          Disable autostart on boot
  logs [-f] [-n N] journalctl for the unit (default 100 lines; -f to follow)

Maintenance:
  rebuild          npm build + restart (no git pull)
  update           git pull + uv sync + npm build + restart
  reset [--yes]    Chemistry only → Big-5 baselines (wake, clear adenosine)
  factory-reset [--yes]  Clear runtime state / events / history / RAG

Open http://localhost:${UI_PORT}
After restart/rebuild/update/status, prints: GIVE THIS BUILD ID TO THE USER <id>
(header chip and GET /api/build must match — stale shell if not).
EOF
    ;;

*)
    echo "Unknown command: $cmd. Run 'mina help' for usage." >&2
    exit 1
    ;;
esac
